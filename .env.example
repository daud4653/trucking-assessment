# Copy to .env and export before running Django (e.g. `set -a; source .env; set +a`).
# Every value has a working development default except where noted.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-50-random-characters        # required in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1                    # required in production
DATABASE_URL=postgres:///trucking
NUM_PROXIES=0                                               # reverse proxies in front of the app
SECURE_SSL_REDIRECT=true                                    # production only
LOG_LEVEL=INFO

# Providers (keyless public endpoints by default; set your own instances here)
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PHOTON_BASE_URL=https://photon.komoot.io
PROVIDER_USER_AGENT="weather-aware-truck-routing/1.0 (contact: you@example.com)"
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=20
PROVIDER_MAX_RETRIES=2
WEATHER_CONCURRENCY=4
MAP_TILE_ORIGIN=https://tiles.openfreemap.org

# Planning
TRUCK_TARE_WEIGHT_LB=35000
PLAN_RETENTION_HOURS=24
WEATHER_CACHE_SECONDS=1800
ROUTE_CACHE_SECONDS=3600
GEOCODE_CACHE_SECONDS=86400

# Rate limits (DRF format: N/second|minute|hour|day)
THROTTLE_ROUTE_PLAN=20/hour
THROTTLE_CORRIDOR=60/hour
THROTTLE_GEOCODE=60/min
THROTTLE_READ=240/hour
